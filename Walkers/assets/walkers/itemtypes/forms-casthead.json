// Weapon heads cast from silver in walkers:silvermold-fired-<type>. Shapes and transforms are the
// nearest vanilla heads (spearhead-copper, arrowhead-silver, knifeblade-silver),
// retextured with silver. Each head melts back to silver in a crucible (100 units per mold pour).
{
	code: "casthead",
	variantgroups: [
		{ code: "type", states: ["spear", "arrow", "knife"] },
		{ code: "metal", states: ["silver"] }
	],
	behaviorsByType: {
		"*": [
			{ name: "GroundStorable", properties: { layout: 'Quadrants', collisionBox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.125, z2: 1 } } }
		]
	},
	heldTpUseAnimation: "interactstatic",
	maxstacksizeByType: {
		"*-arrow-*": 64,
		"*": 4
	},
	shapeByType: {
		"*-spear-*": { base: "game:item/tool/spear/metal-copper" },
		"*-arrow-*": { base: "game:item/tool/arrowhead-copper" },
		"*-knife-*": { base: "game:item/tool/knife/copper" }
	},
	particlesTextureCodeByType: {
		"*-spear-*": "ingot",
		"*": "material"
	},
	texturesByType: {
		"*-spear-*": {
			"ingot": { base: "game:block/metal/ingot/{metal}" },
			"string": { base: "game:block/transparent" },
			"handle": { base: "game:block/transparent" }
		},
		"*-arrow-*": {
			"material": { base: "game:block/metal/ingot/{metal}" }
		},
		"*-knife-*": {
			"material": { base: "game:block/metal/ingot/{metal}" },
			"handle": { base: "game:block/transparent" }
		}
	},
	materialDensity: 10500,
	attributes: {
