// A silver spear head, smithed on the vanilla anvil from one silver ingot like vanilla's copper one
// (recipes/smithing/forms-spearhead-silver.json), because vanilla has no silver spear head. Shape and
// transforms are vanilla's spearhead-copper, retextured with silver. Melts back to an ingot in a crucible.
{
	code: "spearhead",
	variantgroups: [
		{ code: "metal", states: ["silver"] }
	],
	behaviors: [
		{ name: "GroundStorable", properties: { layout: 'Quadrants', collisionBox: { x1: 0, y1: 0, z1: 0, x2: 1, y2: 0.125, z2: 1 } } }
	],
	heldTpUseAnimation: "interactstatic",
	maxstacksize: 4,
	shape: { base: "game:item/tool/spear/metal-copper" },
	particlesTextureCode: "ingot",
	textures: {
		"ingot": { base: "game:block/metal/ingot/{metal}" },
		"string": { base: "game:block/transparent" },
		"handle": { base: "game:block/transparent" }
	},
	materialDensity: 10500,
	attributes: {
		onTongTransform: {
			translation: { x: -1.06, y: -0.26, z: -1.3 },
			rotation: { x: 23, y: 94, z: 22 }
		},
		onMetalTongTransform: {
			translation: { x: -1.84, y: -0.12, z: -0.7 },
			rotation: { x: 90, y: 4, z: 90 },
			origin: { x: 1.3, y: -0, z: 0.5 }
