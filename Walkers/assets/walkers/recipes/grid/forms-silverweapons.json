// The smithed silver spear head and a stick make the mod's silver spear, with vanilla's pattern
// (survival recipes/grid/tool/spear.json). Every other silver weapon is vanilla's own.
[
	{
		ingredientPattern: "T	S",
		ingredients: {
			"T": { type: "item", code: "walkers:spearhead-silver" },
			"S": { type: "item", code: "game:stick" }
		},
		width: 1,
		height: 2,
		output: { type: "item", code: "walkers:spear-silver", quantity: 1 }
	}
]
