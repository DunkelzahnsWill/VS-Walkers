# Pinned toolchain for building and testing Walkers. Sourced by the scripts in this folder and by CI.
#
# To move to a new game version: change the three VS_SERVER lines together (MD5 from
# https://api.vintagestory.at/stable.json, SHA-256 from `sha256sum` on the downloaded file),
# then update "game" in Walkers/modinfo.json and re-run scripts/setup.sh.

VS_VERSION=1.22.7
VS_SERVER_URL=https://cdn.vintagestory.at/gamefiles/stable/vs_server_linux-x64_1.22.7.tar.gz
VS_SERVER_MD5=3031212903b1c283084d5fe0cda6bce6
VS_SERVER_SHA256=a7d4a520604590a96de812ee6c6baf4404d43d86cf1ec4fbac1b3a580b52c847

# Game 1.22 code mods target net10.0; any 10.0 SDK works (see global.json).
DOTNET_CHANNEL=10.0
